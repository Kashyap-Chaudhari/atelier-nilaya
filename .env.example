# ==============================================================================
# ATELIER NILAYA — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env on your server and update the secrets.
# ==============================================================================

# 1. CORE DJANGO SECURITY
# Generate a new 50+ character key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-production

# Always False in production!
DEBUG=False

# Comma-separated list of your live domains and server IPs
ALLOWED_HOSTS=ateliernilaya.com,www.ateliernilaya.com,your-server-ip

# HTTPS Trusted Origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://ateliernilaya.com,https://www.ateliernilaya.com

# 2. DATABASE CONFIGURATION (Supabase PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres.rkjkxlvlfckdorfqwqic:your_password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://rkjkxlvlfckdorfqwqic.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 3. TRANSACTIONAL EMAIL (Required for real customer order & OTP emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_or_ses_api_key
DEFAULT_FROM_EMAIL=Atelier Nilaya <care@ateliernilaya.com>

# 4. PAYMENT GATEWAY (Optional: Live Razorpay credentials if using Razorpay)
RAZORPAY_KEY_ID=rzp_live_yourLiveKeyIdHere
RAZORPAY_KEY_SECRET=yourLiveKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# 5. MESSAGING / WHATSAPP ALERTS (Optional)
WHATSAPP_API_TOKEN=your_whatsapp_meta_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
COURIER_API_KEY=your_courier_bluedart_or_shiprocket_key
